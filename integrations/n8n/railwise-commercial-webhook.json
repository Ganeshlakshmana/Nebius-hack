{
  "name": "railwise-commercial-webhook",
  "nodes": [
    {
      "id": "dashboard-request",
      "name": "Dashboard request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "railwise-commercial",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "railwise-commercial"
    },
    {
      "id": "evaluate-commercial-scenario",
      "name": "Evaluate commercial scenario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-RAILWISE-PUBLIC-HOST/api/internal/commercial/evaluate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "return-result",
      "name": "Return result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        560,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    }
  ],
  "connections": {
    "Dashboard request": {
      "main": [
        [
          {
            "node": "Evaluate commercial scenario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate commercial scenario": {
      "main": [
        [
          {
            "node": "Return result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin"
  }
}
