# Copy to .env locally. Never commit real credentials.
INTERNAL_AGENT_API_KEY=replace-with-a-random-agent-key
INTERNAL_AGENT_SECRET=replace-with-at-least-32-random-characters

# Optional external search; live calls require OFFLINE_MODE=false.
TAVILY_API_KEY=
LLM_API_KEY=
LLM_MODEL=
OFFLINE_MODE=true
FEED_SPEED_SECONDS=5
DATASET_PATH=./data/supplier_risk_dataset.csv
